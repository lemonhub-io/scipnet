    "@jsquash/webp": "^1.5.0",
    "@simplewebauthn/browser": "^14.0.0",
    "@simplewebauthn/server": "^14.0.3",
    "hono": "^4.13.12",
    "i18next": "^26.4.2",
    "i18next-browser-languagedetector": "^8.2.1",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "react-easy-crop": "^6.2.3",
    "react-i18next": "^17.0.15",
    "react-markdown": "^10.1.0",
    "react-router-dom": "^7.18.4",
