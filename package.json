  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "check": "tsc -b --pretty false",
    "deploy": "npm run build && wrangler deploy",
    "db:create": "wrangler d1 create agora-db",
    "db:migrate": "wrangler d1 migrations apply agora-db",
    "db:migrate:local": "wrangler d1 migrations apply agora-db --local",
    "bucket:create": "wrangler r2 bucket create agora-cdn",
    "types": "wrangler types"
  },
  "dependencies": {
    "@block65/webcrypto-web-push": "^2.0.0",
